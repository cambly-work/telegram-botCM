# .env.example

# ───────────────────────────────
# Telegram
# ───────────────────────────────
BOT_TOKEN=123456:ABCDEF             # токен бота от @BotFather
ADMIN_IDS=1648917869                # id админов через запятую, напр. "1648917869,123456789"
PUBLIC_BASE_URL=https://your-domain.com   # https url до твоего бота (используется для вебхука)
WEBHOOK_SECRET=change_me            # секретная строка для защиты вебхука

# ───────────────────────────────
# Database (PostgreSQL)
# ───────────────────────────────
DB_DSN=postgresql://magnet:magnet_pwd@localhost:5432/magnetism

# ───────────────────────────────
# Redis (если нужно для кешей/сессий в будущем)
# ───────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────
# Timezone & Scheduler
# ───────────────────────────────
BOT_TIMEZONE=Europe/Moscow          # для cron (например Europe/Moscow)
TIME_SEND_LESSONS=10:00             # время выдачи уроков D1–D3

# ───────────────────────────────
# Club / Funnel / Links
# ───────────────────────────────
WELCOME_POST_URL=https://t.me/+7H1ZO3ApkDI4NDVi   # привет-пост
SUPPORT_CONTACT=@codemagnetic                    # ник поддержки (без пробелов)

# ID чата клуба (канал/группа), куда бот будет генерировать инвайты.
# ⚠️ должен быть Chat ID (например -1001234567890), бот обязан быть админом.
CLUB_CHAT_ID=

# если клуб станет платным — укажи product_id (например от Antitraining)
AT_PRODUCT_ID_CLUB=

# ───────────────────────────────
# Antitraining (АТ) Webhooks
# ───────────────────────────────
AT_WEBHOOK_SHARED_SECRET=change_me   # секрет для подписи вебхуков от АТ (опц.)

# ───────────────────────────────
# Optional (для дальнейших доработок)
# ───────────────────────────────
# CHECKOUT_URL=https://antitraining.example/checkout/12345
