# Copy to .env and adjust values for your environment

# Telegram bot credentials
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
# Optional: second-level staff admins (same formatting as ADMIN_IDS)
STAFF_ADMIN_IDS=
PUBLIC_BASE_URL=https://your.domain.com
WEBHOOK_SECRET=change_me

# Optional: automatically resolve PUBLIC_BASE_URL via cloudflared
# Set PUBLIC_BASE_URL=cloudflared and CLOUDFLARED_AUTOFETCH=1 to enable auto-detection
CLOUDFLARED_AUTOFETCH=0
CLOUDFLARED_METRICS_URL=http://cloudflared:49999/metrics
CLOUDFLARED_HOSTNAME_SUFFIXES=trycloudflare.com,cfargotunnel.com
CLOUDFLARED_URL_REGEX=

# Optional: automatically resolve PUBLIC_BASE_URL via ngrok
# Set PUBLIC_BASE_URL=ngrok and NGROK_AUTOFETCH=1 to enable auto-detection
NGROK_AUTOFETCH=0
NGROK_API_URL=http://ngrok:4040/api/tunnels
NGROK_API_TOKEN=
NGROK_TUNNEL_NAME=
NGROK_AUTHTOKEN=
# Optional: override the address ngrok should forward to (default: bot:8000)
NGROK_FORWARD_ADDR=

# Database connection for asyncpg (default matches docker-compose)
DB_DSN=postgresql://magnet:magnet_pwd@postgres:5432/magnetism

# Scheduler configuration
BOT_TIMEZONE=Europe/Moscow
TIME_SEND_LESSONS=10:00

# Links / club configuration
WELCOME_POST_URL=https://t.me/your_channel
SUPPORT_CONTACT=@your_support
CLUB_CHAT_ID=

# Optional integration secrets
AT_WEBHOOK_SHARED_SECRET=
YOOMONEY_CHECKOUT_URL=
YOOMONEY_WEBHOOK_SECRET=
